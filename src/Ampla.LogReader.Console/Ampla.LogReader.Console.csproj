<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ampla.LogReader.Console</RootNamespace>
    <AssemblyName>Ampla.LogReader.Console</AssemblyName>
    <PlatformTarget>x86</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <ItemGroup>
    <!-- Updated to modern versions -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommandLineParser" Version="1.9.71" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ampla.LogReader\Ampla.LogReader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Assembly.Common.cs" Link="Properties\Assembly.Common.cs" />
    <Compile Include="..\Assembly.Version.cs" Link="Properties\Assembly.Version.cs" />
  </ItemGroup>

</Project>