<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Ampla.LogReader</RootNamespace>
    <AssemblyName>Ampla.LogReader</AssemblyName>
    <PlatformTarget>x86</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Assembly.Common.cs" Link="Properties\Assembly.Common.cs" />
    <Compile Include="..\Assembly.Version.cs" Link="Properties\Assembly.Version.cs" />
  </ItemGroup>

</Project>